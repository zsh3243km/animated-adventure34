# Lumen v34 — optional environment variables.
# Nothing here is required: the panel sets itself up on first boot.

# ── Branding ────────────────────────────────────────────────────────────────
# Text shown after every config name in the client app.
CONFIG_TITLE=Lumen
# Set to off to skip creating the demo reseller account.
DEMO_RESELLER=on

# ── Managed exit proxies (the Lumen addition) ───────────────────────────────
# The repository object is read with AWS Signature V4. S3, idrivee2, Backblaze
# and other S3-compatible stores all work as long as the region below is right.
#
# URL form: the full object URL, with the bucket in the path.
#   https://s3.<region>.<host>/<bucket>/<key>
LUMEN_PROXY_REPO_URL=https://s3.us-west-2.idrivee2.com/bt2/www-32k-ort-org-021/proxy.txt

LUMEN_S3_ACCESS_KEY_ID=41DUl3Aw2SiWuFW2OZ9P
LUMEN_S3_SECRET_ACCESS_KEY=aID0sUgRZPle6RmGsxbOaULOwwYpACBMAs39vkjH
LUMEN_PROXY_REPO_REGION=us-west-2

# Only used for the signature; LUMEN_PROXY_REPO_URL is what is actually fetched.
LUMEN_S3_ENDPOINT=https://s3.us-west-2.idrivee2.com

# How often the catalog is refetched. 0 disables scheduled refreshes; the
# Refresh button in the dashboard still works.
LUMEN_PROXY_REFRESH_SECONDS=7200

# When set, the write endpoints (refresh, test, assign) require this value in
# the X-Lumen-Key header. Paste it into the dashboard's browser console once:
#   localStorage.setItem('lumen-proxy-key', '<your value>')
PROXY_REPOSITORY_MANUAL_REFRESH_KEY=

# ── Data plane ──────────────────────────────────────────────────────────────
# Xray log level: none, error, warning, info, debug
LUMEN_XRAY_LOGLEVEL=warning
# The pinned Xray core release is set in the Dockerfile as XRAY_VERSION.